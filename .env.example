# =============================================================================
# Bententrade — шаблон переменных окружения
# Скопируйте этот файл в .env (локально) или вставьте строки в Railway → Web-сервис → Variables
# Секреты НЕ коммитьте. Для генерации токенов: npm run env:secrets
#
# Production (NODE_ENV=production или REQUIRE_PROD_SECRETS=true): server.js не стартует без
# DATABASE_URL, длинного API_TOKEN (≥16), ADMIN_PASSWORD (≥12) и ADMIN_JWT_SECRET (≥32). Railway обычно задаёт NODE_ENV=production.
# Локальная отладка server.js без жёсткой проверки: не выставляйте NODE_ENV=production или
# REQUIRE_PROD_SECRETS=false
# =============================================================================

# --- PostgreSQL ---
# На Railway (Web-сервис): только Reference → DATABASE_URL из сервиса Postgres (хост *.railway.internal).
# С компьютера .internal НЕ работает — для локального .env возьмите DATABASE_PUBLIC_URL из Postgres → Connect.
DATABASE_URL=

# Опционально: таймаут подключения (мс), если запросы к БД «висят»
# PG_CONNECTION_TIMEOUT_MS=15000

# Отключить SSL к БД только если провайдер требует (по умолчанию в коде SSL включён для Railway)
# DATABASE_SSL=false

# --- Защита API (Bearer-токен; должен совпадать с VITE_API_TOKEN на фронте при сборке) ---
API_TOKEN=

# --- Админ-панель на сайте (пароль для входа) ---
ADMIN_PASSWORD=

# --- Подпись JWT сессии админки (в production обязателен, длина ≥ 32; см. server.js) ---
# Локально при отсутствии переменной сервер может вывести предупреждение и использовать производный секрет.
ADMIN_JWT_SECRET=

# --- Telegram-уведомления о заказах (необязательно) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Лимит POST /api/telegram/send и /api/telegram/test с одного IP (таблица telegram_outbound_attempts) ---
# TELEGRAM_OUTBOUND_RATE_MAX=35
# TELEGRAM_OUTBOUND_RATE_WINDOW_MS=900000
# TELEGRAM_OUTBOUND_RATE_DISABLED=true

# --- Фронтенд (подставляются в Vite при npm run build; для продакшена задайте в CI/Railway) ---
VITE_API_BASE_URL=/api
VITE_API_TOKEN=

# --- Канонический URL сайта (для пререндера SEO; по умолчанию в скрипте bententrade.uz) ---
# Если задан SITE_ORIGIN и не задан CORS_ALLOWED_ORIGINS — для API включается строгий CORS только с этого Origin (учтите www и dev: см. ниже).
# SITE_ORIGIN=https://bententrade.uz

# --- CORS для браузерных запросов к /api (если пусто и SITE_ORIGIN не задан — разрешено *) ---
# Несколько доменов через запятую, без пробела после запятой или с пробелом (trim в коде).
# CORS_ALLOWED_ORIGINS=https://bententrade.uz,https://www.bententrade.uz,http://localhost:5173

# --- Загрузка изображений в CMS: макс. размер файла после декодирования (байт), по умолчанию 5 MiB ---
# ADMIN_MEDIA_MAX_BYTES=5242880

# --- Legacy: GET /api/load-data и /api/get-data (миграция каталога). В production выключены, пока не задано true ---
# ENABLE_LEGACY_DATA_ENDPOINTS=true

# --- Валидация POST /api/orders (опционально, есть разумные дефолты) ---
# MAX_ORDER_ITEMS=40
# MAX_ORDER_FIELD_LEN=2000
# MAX_ORDER_ITEM_NAME_LEN=500

# --- Макс. размер JSON-тела POST /api/orders (байт), по умолчанию 256 KiB ---
# ORDER_BODY_MAX_BYTES=262144

# --- Порт (Railway задаёт сам; локально можно не указывать) ---
# PORT=3000

# --- Только отладка: отключить обязательные секреты (НЕ для публичного продакшена) ---
# REQUIRE_PROD_SECRETS=false

# --- Опционально: пороги длины (по умолчанию 16 и 12) ---
# MIN_API_TOKEN_LEN=16
# MIN_ADMIN_PASSWORD_LEN=12

# --- Лимит попыток POST /api/admin/login с одного IP (учёт в PostgreSQL, таблица admin_login_failures; общий лимит для нескольких инстансов) ---
# Пока БД не поднята — используется временный in-memory fallback.
# ADMIN_LOGIN_RATE_MAX=15
# ADMIN_LOGIN_RATE_WINDOW_MS=900000
# ADMIN_LOGIN_RATE_DISABLED=true

# --- Лимит POST /api/orders с одного IP (анти-спам; таблица order_submit_attempts в PostgreSQL) ---
# ORDER_SUBMIT_RATE_MAX=25
# ORDER_SUBMIT_RATE_WINDOW_MS=900000
# ORDER_SUBMIT_RATE_DISABLED=true

# --- Только JWT для CMS (без заголовка X-Admin-Password на /api/admin/*). Логин /api/admin/login не затрагивается. ---
# ADMIN_SESSION_PASSWORD_DISABLED=true

# --- Диагностика: GET /api/health?detailed=1 + Authorization: Bearer <API_TOKEN> — в JSON появится dbError (только для админов) ---
